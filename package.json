{
  "name": "oxigen-reporting",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "import": "tsx server/cli-import.ts",
    "build:artifact": "vite build -c vite.artifact.config.ts && tsx scripts/package-artifact.ts"
  },
  "dependencies": {
    "@fontsource/arimo": "^5.1.0",
    "@fontsource/lato": "^5.1.0",
    "@xmldom/xmldom": "^0.8.10",
    "express": "^4.21.1",
    "jszip": "^3.10.1",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tsx": "^4.19.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.9",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
